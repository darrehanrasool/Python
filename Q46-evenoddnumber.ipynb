   "source": [
    "# Check whether a number is even or odd\n",
    "\n",
    "n = int(input(\"Enter a number: \"))\n",
    "\n",
    "if n % 2 == 0:\n",
    "    print(f\"{n} is Even\")\n",
    "else:\n",
    "    print(f\"{n} is Odd\")"
   ]
  }

      "source": [
        "import math\n",
        "\n",
        "value = float(input('Enter a positive number: '))\n",
        "base = float(input('Enter a positive base (not 1): '))\n",
        "\n",
        "## A logarithm answers: base raised to what power gives value?\n",
        "logarithm = math.log(value, base)\n",
        "\n",
        "print(f'Log base {base:g} of {value:g}: {logarithm:.6f}')"
      ]
    }
  ],

   "source": [
    "## Palindrome buddy \n",
    "number=int(input(\"Enter the number buddy\"))\n",
    "data=number\n",
    "rev=0\n",
    "while number>0:\n",
    "    r=number%10\n",
    "    rev=rev*10+r\n",
    "    number=number//10\n",
    "    \n",
    "if data==rev:\n",
    "    print(f\"{data} is a palindrome\")\n",
    "else:\n",
    "    print(f\"{data} is not a palindrome\")\n",
    "        \n",
    "    \n",
    "\n",
    "    \n"
   ]
  }
 ],

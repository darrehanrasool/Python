      "source": [
        "import math\n",
        "\n",
        "radius = float(input('Enter the circle radius: '))\n",
        "\n",
        "## Circle formulas: area = pi * r^2; circumference = 2 * pi * r.\n",
        "area = math.pi * radius ** 2\n",
        "circumference = 2 * math.pi * radius\n",
        "\n",
        "print(f'Area: {area:.2f}')\n",
        "print(f'Circumference: {circumference:.2f}')"
      ]
    }
  ],

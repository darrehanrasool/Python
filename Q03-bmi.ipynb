      "source": [
        "weight_kg = float(input('Enter weight in kilograms: '))\n",
        "height_m = float(input('Enter height in metres: '))\n",
        "\n",
        "## BMI formula: weight in kilograms divided by height in metres squared.\n",
        "bmi = weight_kg / height_m ** 2\n",
        "\n",
        "print(f'BMI: {bmi:.2f}')"
      ]
    }

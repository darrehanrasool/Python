   "source": [
    "# factorial \n",
    "n=int(input(\"enter the number buddy\"))\n",
    "fac=1\n",
    "for i in range(1,n+1):\n",
    "    fac*=i\n",
    "    print(f\"factorial of a number {i} is : {fac}\")\n"
   ]
  }

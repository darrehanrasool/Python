   "source": [
    "# Fahrenheit to Celsius\n",
    "\n",
    "fahrenheit = float(input(\"Enter temperature in Fahrenheit: \"))\n",
    "\n",
    "celsius = (fahrenheit - 32) * 5 / 9\n",
    "\n",
    "print(\"Temperature in Celsius:\", celsius)"
   ]

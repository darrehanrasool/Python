   "source": [
    "# fibonacci series\n",
    "n=int(input(\"Enter the number buddy till you want fibonacci series\"))\n",
    "a=0\n",
    "b=1\n",
    "for i in range(1,n):\n",
    "    c=a+b\n",
    "    a=b\n",
    "    b=c\n",
    "    print(f\"fibonacci of {i} is {a}\")\n"
   ]
  }

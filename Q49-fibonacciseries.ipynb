    "# fibonacci series\n",
    "n=int(input(\"Enter the number till you want fibonacci series\"))\n",
    "a=0\n",
    "b=1\n",
    "for i in range(0,n):\n",
    "    c=a+b\n",
    "    a=b\n",
    "    b=c\n",
    "    print(f'fibonaci values {a}')\n"
